    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "gl-matrix": "3.4.4",
    "@swc/helpers": "0.5.23",
    "brotli": "1.3.3",
    "clone": "2.1.2",
    "dfa": "1.2.0",
    "fast-deep-equal": "3.1.3",
    "restructure": "3.0.2",
    "tiny-inflate": "1.0.3",
