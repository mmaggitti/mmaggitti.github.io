{
  "name": "draw",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/check-sinks.mjs && node tools/ledger-check.mjs && tsc --noEmit && npm run test:unit && node tools/ledger-check.mjs --evidence node_modules/.evidence.jsonl && vite build && node tools/check-bundle.mjs && node tools/library-index.mjs",
    "test:unit": "node --test --test-reporter=dot --test-reporter-destination=stdout --test-reporter=./tools/evidence-reporter.mjs --test-reporter-destination=node_modules/.evidence.jsonl \"../../engine/test/**/*.test.ts\" \"test/unit/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dm-serif-display": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "dompurify": "3.4.16",
    "fontkit": "2.0.4",
    "idb-keyval": "6.3.0",
    "paper": "0.12.18",
    "path-bool": "1.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "svg-element-attributes": "2.2.0",
