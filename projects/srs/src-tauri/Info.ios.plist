<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Merged by the Tauri CLI over the generated gen/apple Info.plist (gen/ is not committed: it is
  regenerated on the Mac by `tauri ios init`, and holds signing settings that must not go public).

  UIApplicationSceneManifest: the UIScene lifecycle, which apps built with the iOS 27 SDK need to
  launch at all (Apple TN3187). Tauri 2.12 supports it but leaves it opt-in (tauri-cli 2.12
  changelog, #15890). Verify on the device in S6.

  UIFileSharingEnabled + LSSupportsOpeningDocumentsInPlace: the app's Documents folder shows in
  the Files app, so exports can be found and files opened where they are (DOCTRINE §6).

  The status bar stays visible: the PWA shows it too, so the two builds lay out the same.
-->
<plist version="1.0">
<dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
</dict>
</plist>
